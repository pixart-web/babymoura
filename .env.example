# Copiar para .env e ajustar. Nunca colocar segredos reais neste ficheiro de exemplo.
WP_PORT=8090
MAILPIT_PORT=8026
DB_PASSWORD=babymoura-local
WP_ENVIRONMENT_TYPE=local

# demo       -> formulários mostram "Demonstração — os dados não serão enviados." e nada é guardado/enviado.
# production -> pedidos guardados no WordPress e notificados por email para BABYMOURA_FORM_RECIPIENT.
BABYMOURA_MODE=demo

# Destinatário dos pedidos (definido pela instituição). Vazio = formulários recusam envio em produção.
BABYMOURA_FORM_RECIPIENT=
# Remetente técnico (deve pertencer a um domínio com SPF/DKIM configurados).
BABYMOURA_FORM_FROM=

# Transporte SMTP. Localmente aponta para o Mailpit (http://localhost:8026), que não envia nada para fora.
BABYMOURA_SMTP_HOST=mailpit
BABYMOURA_SMTP_PORT=1025
BABYMOURA_SMTP_USER=
BABYMOURA_SMTP_PASS=
# tls | ssl | vazio
BABYMOURA_SMTP_SECURE=

# Proteção opcional do preview privado (HTTP Basic), formato utilizador:palavra-passe.
BABYMOURA_PREVIEW_AUTH=
