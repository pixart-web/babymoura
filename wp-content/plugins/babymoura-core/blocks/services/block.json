{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "babymoura/services",
	"title": "Serviços complementares",
	"category": "babymoura",
	"icon": "heart",
	"description": "Serviços da instituição, separados das atividades.",
	"textdomain": "babymoura-core",
	"attributes": {
		"stage": {
			"type": "string",
			"default": "all",
			"enum": [
				"all",
				"creche",
				"jardim"
			]
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"className": true
	},
	"editorScript": "bm-editor",
	"render": "file:./render.php"
}