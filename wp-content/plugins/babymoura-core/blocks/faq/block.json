{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "babymoura/faq",
	"title": "Perguntas frequentes",
	"category": "babymoura",
	"icon": "editor-help",
	"description": "Acordeão acessível com perguntas confirmadas.",
	"textdomain": "babymoura-core",
	"attributes": {
		"group": {
			"type": "string",
			"default": ""
		},
		"homeOnly": {
			"type": "boolean",
			"default": false
		},
		"limit": {
			"type": "number",
			"default": 0
		},
		"headingLevel": {
			"type": "number",
			"default": 3
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"className": true
	},
	"editorScript": "bm-editor",
	"render": "file:./render.php"
}