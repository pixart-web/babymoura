{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "babymoura/form",
	"title": "Formulário de pedido",
	"category": "babymoura",
	"icon": "feedback",
	"description": "Pedido de visita ou pré-inscrição, com modo demonstração.",
	"textdomain": "babymoura-core",
	"attributes": {
		"formType": {
			"type": "string",
			"default": "visita",
			"enum": [
				"visita",
				"pre-inscricao"
			]
		},
		"stage": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"className": true
	},
	"editorScript": "bm-editor",
	"render": "file:./render.php",
	"viewScript": "bm-forms"
}